<mxfile host="app.diagrams.net" compressed="false"><diagram name="Overview" id="page1"><mxGraphModel page="1" pageWidth="1100" pageHeight="700" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" vertex="1" parent="1" value="PharmaShelf data flows" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="3" vertex="1" parent="1" value="Five paths through the same branch workspace" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="4" vertex="1" parent="1" value="Domain API" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="120" width="1000" height="25" as="geometry" /></mxCell><mxCell id="5" vertex="1" parent="1" value="Studio or Swagger&#10;sends a request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="151" width="235" height="60" as="geometry" /></mxCell><mxCell id="6" vertex="1" parent="1" value="FastAPI checks input&#10;and access" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#f6f7ef;strokeColor=#a9c4bd;"><mxGeometry x="299" y="151" width="235" height="60" as="geometry" /></mxCell><mxCell id="7" edge="1" parent="1" source="5" target="6" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="8" vertex="1" parent="1" value="Service + repository&#10;use PostgreSQL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eef3fa;strokeColor=#a9c4bd;"><mxGeometry x="564" y="151" width="235" height="60" as="geometry" /></mxCell><mxCell id="9" edge="1" parent="1" source="6" target="8" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" vertex="1" parent="1" value="API returns a&#10;validated response" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#e9f4f2;strokeColor=#a9c4bd;"><mxGeometry x="829" y="151" width="235" height="60" as="geometry" /></mxCell><mxCell id="11" edge="1" parent="1" source="8" target="10" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" vertex="1" parent="1" value="Authentication" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="232" width="1000" height="25" as="geometry" /></mxCell><mxCell id="13" vertex="1" parent="1" value="Login form sends&#10;email + password" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="263" width="235" height="60" as="geometry" /></mxCell><mxCell id="14" vertex="1" parent="1" value="Auth service verifies&#10;stored password hash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#f6f7ef;strokeColor=#a9c4bd;"><mxGeometry x="299" y="263" width="235" height="60" as="geometry" /></mxCell><mxCell id="15" edge="1" parent="1" source="13" target="14" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" vertex="1" parent="1" value="API issues JWT&#10;with an expiry" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eef3fa;strokeColor=#a9c4bd;"><mxGeometry x="564" y="263" width="235" height="60" as="geometry" /></mxCell><mxCell id="17" edge="1" parent="1" source="14" target="16" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" vertex="1" parent="1" value="Protected route checks&#10;token + database role" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#e9f4f2;strokeColor=#a9c4bd;"><mxGeometry x="829" y="263" width="235" height="60" as="geometry" /></mxCell><mxCell id="19" edge="1" parent="1" source="16" target="18" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="20" vertex="1" parent="1" value="Customer chat" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="344" width="1000" height="25" as="geometry" /></mxCell><mxCell id="21" vertex="1" parent="1" value="Question + recent&#10;conversation history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="375" width="235" height="60" as="geometry" /></mxCell><mxCell id="22" vertex="1" parent="1" value="Gemini chooses&#10;a catalog tool" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#f6f7ef;strokeColor=#a9c4bd;"><mxGeometry x="299" y="375" width="235" height="60" as="geometry" /></mxCell><mxCell id="23" edge="1" parent="1" source="21" target="22" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" vertex="1" parent="1" value="Backend looks up&#10;catalog or stock" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eef3fa;strokeColor=#a9c4bd;"><mxGeometry x="564" y="375" width="235" height="60" as="geometry" /></mxCell><mxCell id="25" edge="1" parent="1" source="22" target="24" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" vertex="1" parent="1" value="Gemini receives result&#10;and writes reply" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#e9f4f2;strokeColor=#a9c4bd;"><mxGeometry x="829" y="375" width="235" height="60" as="geometry" /></mxCell><mxCell id="27" edge="1" parent="1" source="24" target="26" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="28" vertex="1" parent="1" value="Owner RAG" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="456" width="1000" height="25" as="geometry" /></mxCell><mxCell id="29" vertex="1" parent="1" value="Owner asks an&#10;Almanac question" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="487" width="235" height="60" as="geometry" /></mxCell><mxCell id="30" vertex="1" parent="1" value="Embedding service&#10;encodes question" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#f6f7ef;strokeColor=#a9c4bd;"><mxGeometry x="299" y="487" width="235" height="60" as="geometry" /></mxCell><mxCell id="31" edge="1" parent="1" source="29" target="30" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="32" vertex="1" parent="1" value="pgvector retrieves&#10;relevant passages" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eef3fa;strokeColor=#a9c4bd;"><mxGeometry x="564" y="487" width="235" height="60" as="geometry" /></mxCell><mxCell id="33" edge="1" parent="1" source="30" target="32" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="34" vertex="1" parent="1" value="Cited reply or&#10;no-match response" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#e9f4f2;strokeColor=#a9c4bd;"><mxGeometry x="829" y="487" width="235" height="60" as="geometry" /></mxCell><mxCell id="35" edge="1" parent="1" source="32" target="34" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="36" vertex="1" parent="1" value="MCP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="568" width="1000" height="25" as="geometry" /></mxCell><mxCell id="37" vertex="1" parent="1" value="MCP client connects&#10;via HTTP or stdio" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="599" width="235" height="60" as="geometry" /></mxCell><mxCell id="38" vertex="1" parent="1" value="Client selects tool,&#10;resource, or prompt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#f6f7ef;strokeColor=#a9c4bd;"><mxGeometry x="299" y="599" width="235" height="60" as="geometry" /></mxCell><mxCell id="39" edge="1" parent="1" source="37" target="38" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="40" vertex="1" parent="1" value="Server dispatches&#10;registered handler" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#eef3fa;strokeColor=#a9c4bd;"><mxGeometry x="564" y="599" width="235" height="60" as="geometry" /></mxCell><mxCell id="41" edge="1" parent="1" source="38" target="40" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="42" vertex="1" parent="1" value="Client receives data&#10;or prompt text" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#123c36;fontStyle=0;fillColor=#e9f4f2;strokeColor=#a9c4bd;"><mxGeometry x="829" y="599" width="235" height="60" as="geometry" /></mxCell><mxCell id="43" edge="1" parent="1" source="40" target="42" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Domain API" id="page2"><mxGraphModel page="1" pageWidth="1100" pageHeight="580" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="44" vertex="1" parent="1" value="Domain API" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="45" vertex="1" parent="1" value="Example: preview and confirm a sales workbook" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="46" vertex="1" parent="1" value="1. Owner uploads&#10;&#10;POST /api/v1/imports/sales/preview&#10;File + optional column mapping" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="47" vertex="1" parent="1" value="2. Controller checks&#10;&#10;Require admin; limit file size.&#10;Parse the workbook in a worker thread." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="48" edge="1" parent="1" source="46" target="47" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="49" vertex="1" parent="1" value="3. Preview against DB&#10;&#10;Validate rows, batch IDs and sale IDs.&#10;Return totals, preview rows and errors." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="50" edge="1" parent="1" source="47" target="49" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="51" vertex="1" parent="1" value="4. Owner confirms&#10;&#10;POST /api/v1/imports/sales/confirm&#10;Re-read and validate the submitted file." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="52" edge="1" parent="1" source="49" target="51" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="53" vertex="1" parent="1" value="5. Commit transaction&#10;&#10;Lock batches; insert new sale IDs;&#10;deduct units; skip identical retries." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="54" edge="1" parent="1" source="51" target="53" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="55" vertex="1" parent="1" value="6. Return result&#10;&#10;Report inserts, skips, units and revenue.&#10;A conflict rolls back the import." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="56" edge="1" parent="1" source="53" target="55" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Authentication" id="page3"><mxGraphModel page="1" pageWidth="1100" pageHeight="580" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="57" vertex="1" parent="1" value="Authentication" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="58" vertex="1" parent="1" value="Example: authorize the owner expiry report" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="59" vertex="1" parent="1" value="1. Register&#10;&#10;POST /api/v1/auth/register&#10;Normalize email and hash the password." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="60" vertex="1" parent="1" value="2. Store identity&#10;&#10;PostgreSQL users table stores the hash,&#10;active flag and customer role by default." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="61" edge="1" parent="1" source="59" target="60" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="62" vertex="1" parent="1" value="3. Login&#10;&#10;POST /api/v1/auth/login&#10;Verify password and active account." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="63" edge="1" parent="1" source="60" target="62" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="64" vertex="1" parent="1" value="4. Issue token&#10;&#10;Return a signed JWT for the user ID&#10;with a configured expiry." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="65" edge="1" parent="1" source="62" target="64" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="66" vertex="1" parent="1" value="5. Authenticate request&#10;&#10;Read Authorization: Bearer token.&#10;Validate JWT and load current DB user." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="67" edge="1" parent="1" source="64" target="66" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="68" vertex="1" parent="1" value="6. Authorize report&#10;&#10;require_admin permits admin → report.&#10;Missing token → 401; wrong role → 403." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="69" edge="1" parent="1" source="66" target="68" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Customer chat" id="page4"><mxGraphModel page="1" pageWidth="1100" pageHeight="580" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="70" vertex="1" parent="1" value="Customer chat" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="71" vertex="1" parent="1" value="Example: Is paracetamol available at DEMO-01?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="72" vertex="1" parent="1" value="1. Receive conversation&#10;&#10;POST /api/v1/chat&#10;Validate content and supplied history." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="73" vertex="1" parent="1" value="2. Ask Gemini&#10;&#10;CustomerChatService sends prompt,&#10;history and two tool declarations." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="74" edge="1" parent="1" source="72" target="73" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="75" vertex="1" parent="1" value="3. Choose a tool&#10;&#10;For a medicine name, Gemini can request&#10;search_medicines to resolve a SKU." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="76" edge="1" parent="1" source="73" target="75" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="77" vertex="1" parent="1" value="4. Execute lookup&#10;&#10;Backend runs the selected service.&#10;Availability uses exact SKU and branch." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="78" edge="1" parent="1" source="75" target="77" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="79" vertex="1" parent="1" value="5. Continue tool loop&#10;&#10;Append the model call and tool result.&#10;Gemini can ask for another lookup." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="80" edge="1" parent="1" source="77" target="79" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="81" vertex="1" parent="1" value="6. Return answer&#10;&#10;Return reply and tool_calls to the UI.&#10;UI includes recent turns on follow-up." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="82" edge="1" parent="1" source="79" target="81" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Owner RAG" id="page5"><mxGraphModel page="1" pageWidth="1100" pageHeight="580" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="83" vertex="1" parent="1" value="Owner RAG" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="84" vertex="1" parent="1" value="Index Almanac writing during startup; retrieve passages when an owner asks." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="85" vertex="1" parent="1" value="1. Seed and chunk&#10;&#10;Load active Almanac entries. Split text&#10;into up to 100 words, with 15-word overlap." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="86" vertex="1" parent="1" value="2. Embed passages&#10;&#10;Embed title, topic and passage with&#10;BAAI/bge-small-en-v1.5 → 384 values." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="87" edge="1" parent="1" source="85" target="86" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="88" vertex="1" parent="1" value="3. Store index&#10;&#10;Save entry ID, chunk position, text&#10;and embedding in almanac_chunks." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="89" edge="1" parent="1" source="86" target="88" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="90" vertex="1" parent="1" value="4. Owner asks&#10;&#10;POST /api/v1/chat/owner checks admin.&#10;Embed the question using the same model." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="91" edge="1" parent="1" source="88" target="90" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="92" vertex="1" parent="1" value="5. Retrieve evidence&#10;&#10;Join active entries; rank by cosine distance.&#10;Return up to 3 with similarity ≥ 0.65." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="93" edge="1" parent="1" source="90" target="92" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="94" vertex="1" parent="1" value="6. Answer or abstain&#10;&#10;No hits → empty sources. Otherwise Gemini&#10;uses passages; API resolves citation IDs." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="95" edge="1" parent="1" source="92" target="94" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="MCP" id="page6"><mxGraphModel page="1" pageWidth="1100" pageHeight="580" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="96" vertex="1" parent="1" value="MCP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#123c36;fontStyle=1;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="18" width="1032" height="50" as="geometry" /></mxCell><mxCell id="97" vertex="1" parent="1" value="Example: a client calls check_availability through the hosted /mcp endpoint." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#123c36;fontStyle=0;fillColor=none;strokeColor=none;"><mxGeometry x="34" y="73" width="1032" height="34" as="geometry" /></mxCell><mxCell id="98" vertex="1" parent="1" value="1. Connect&#10;&#10;Streamable HTTP at /mcp or a local&#10;stdio subprocess; initialize the session." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="99" vertex="1" parent="1" value="2. Discover&#10;&#10;Client can list tools, resources, prompts.&#10;Server advertises their names and schemas." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="100" edge="1" parent="1" source="98" target="99" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="101" vertex="1" parent="1" value="3. Call tool&#10;&#10;check_availability receives exact SKU&#10;DEMO-PARA-500 and branch DEMO-01." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="150" width="320" height="120" as="geometry" /></mxCell><mxCell id="102" edge="1" parent="1" source="99" target="101" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="103" vertex="1" parent="1" value="4. Dispatch&#10;&#10;FastMCP validates tool arguments.&#10;Handler opens a database session." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="744" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="104" edge="1" parent="1" source="101" target="103" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="105" vertex="1" parent="1" value="5. Read stock&#10;&#10;Customer catalog tools reuse inventory&#10;service and repository to query PostgreSQL." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="389" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="106" edge="1" parent="1" source="103" target="105" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="107" vertex="1" parent="1" value="6. Return tool result&#10;&#10;Client receives SKU, branch and boolean.&#10;The model is optional in this client flow." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#123c36;fontStyle=0;fillColor=#eaf3ef;strokeColor=#a9c4bd;"><mxGeometry x="34" y="360" width="320" height="120" as="geometry" /></mxCell><mxCell id="108" edge="1" parent="1" source="105" target="107" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#477b70;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>